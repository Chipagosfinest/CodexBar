diff --git a/Sources/CodexBar/StatusItem/Diag4902.swift b/Sources/CodexBar/StatusItem/Diag4902.swift
new file mode 100644
index 000000000..e3a76bf06
--- /dev/null
+++ b/Sources/CodexBar/StatusItem/Diag4902.swift
@@ -0,0 +1,46 @@
+import AppKit
+import Foundation
+
+nonisolated func diag4902(_ message: String) {
+    let line = "\(Date().timeIntervalSince1970) \(message)\n"
+    guard let file = fopen("/tmp/cbdiag.log", "a") else { return }
+    fputs(line, file)
+    fclose(file)
+}
+
+@MainActor
+enum Diag4902 {
+    private static var installed = false
+    private static let observer = Diag4902Observer()
+    static func describe(_ menu: NSMenu?) -> String {
+        guard let menu else { return "nil" }
+        return "\(type(of: menu))#\(UInt(bitPattern: ObjectIdentifier(menu).hashValue) % 100_000)(items=\(menu.items.count),super=\(menu.supermenu != nil))"
+    }
+    static func install() {
+        guard !self.installed else { return }
+        self.installed = true
+        let names: [Notification.Name] = [
+            NSMenu.willSendActionNotification, NSMenu.didSendActionNotification,
+            NSMenu.didBeginTrackingNotification, NSMenu.didEndTrackingNotification,
+        ]
+        for name in names {
+            NotificationCenter.default.addObserver(
+                observer, selector: #selector(Diag4902Observer.handle(_:)), name: name, object: nil)
+        }
+        NSEvent.addLocalMonitorForEvents(matching: [.leftMouseDown, .leftMouseUp]) { event in
+            let window = event.window.map { String(describing: type(of: $0)) } ?? "nil"
+            diag4902("EVENT \(event.type.rawValue) window=\(window) loc=\(event.locationInWindow)")
+            return event
+        }
+    }
+}
+
+@MainActor
+final class Diag4902Observer: NSObject {
+    @objc func handle(_ note: Notification) {
+        let item = note.userInfo?["MenuItem"] as? NSMenuItem
+        let title = item?.title ?? "-"
+        let action = item?.action.map { NSStringFromSelector($0) } ?? "-"
+        diag4902("NOTE \(note.name.rawValue) menu=\(Diag4902.describe(note.object as? NSMenu)) item=\(title) action=\(action)")
+    }
+}
